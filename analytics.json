    "leads",
    "qualified_leads",
    "customer_conversations",
    "orders",
    "paid_orders",
    "completed_orders",
    "revenue_ngn",
    "average_order_value_ngn",
    "repeat_customers",
    "conversion_rate"
  ],

  "funnel_stages": [
